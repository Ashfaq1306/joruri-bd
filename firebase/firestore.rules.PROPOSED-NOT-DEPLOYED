// ============================================================================
//  JORURI BD — PROPOSED Firestore Security Rules
//  STATUS: NOT DEPLOYED. Review, test in the Rules Playground, then deploy
//  yourself (see firebase/RULES_PROPOSAL.md). Anything not matched below is
//  denied.
// ============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    // Admins are listed by hand in /admins/{uid} in the Firebase console.
    // Clients can never write /admins (see below), so nobody can make
    // themselves an admin.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBloodGroup(v) { return v in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']; }
    function shortString(v, max) { return v is string && v.size() <= max; }
    function isoString(v) { return v is string && v.size() <= 40; }

    // ---------- official content: read-only for everyone, published only ----------
    // The app always queries with where('published', '==', true); a query
    // without that filter is refused for non-admins.
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /emergency_numbers/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /guides/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /hospitals/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /pharmacies/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- blood donors ----------
    match /donors/{id} {
      // Listing: signed-in users only, and only consented + visible donors.
      // Firestore refuses any query that could return other documents, so
      // the app's where('shareConsent','==',true).where('hidden','==',false)
      // filters are enforced here, on the server. Pages are capped at 300.
      allow list: if signedIn()
        && resource.data.shareConsent == true
        && resource.data.hidden == false
        && request.query.limit <= 300;
      allow list: if isAdmin();

      // Single reads: your own listing, an admin, or a listed+visible donor.
      allow get: if isAdmin()
        || (signedIn() && id == request.auth.uid)
        || (signedIn() && resource.data.shareConsent == true && resource.data.hidden == false);

      // Create: only your own listing, starting un-hidden and NOT verified.
      allow create: if isAdmin() || (
        signedIn() && id == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'uid', 'source', 'name', 'bloodGroup', 'phone', 'districtId',
                                                 'area', 'available', 'shareConsent', 'lastDonation', 'hidden',
                                                 'verified', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'source', 'name', 'bloodGroup', 'phone', 'districtId',
                                                'available', 'shareConsent', 'hidden', 'verified'])
        && request.resource.data.id == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'app'
        && request.resource.data.hidden == false
        && request.resource.data.verified == false
        && validOwnDonorFields(request.resource.data)
      );

      // Update by the owner: ONLY these fields may change. hidden, verified,
      // uid, source and createdAt stay exactly as they are, so a user can
      // never verify or un-hide themselves.
      allow update: if isAdmin() || (
        signedIn() && id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'bloodGroup', 'phone', 'districtId', 'area', 'available', 'shareConsent',
                       'lastDonation', 'updatedAt'])
        && validOwnDonorFields(request.resource.data)
      );

      // Delete: admins, or the owner while NOT hidden by an admin (a hidden
      // listing stays, so deleting and re-registering cannot undo moderation).
      allow delete: if isAdmin() || (signedIn() && id == request.auth.uid && resource.data.hidden == false);
    }

    function validOwnDonorFields(d) {
      return shortString(d.name, 80) && d.name.size() > 0
        && isBloodGroup(d.bloodGroup)
        && d.phone is string && d.phone.matches('^[+]8801[3-9][0-9]{8}$')
        && shortString(d.districtId, 40) && d.districtId.size() > 0
        && shortString(d.get('area', ''), 80)
        && d.available is bool
        && d.shareConsent is bool
        // Not listed means not available.
        && (d.shareConsent == true || d.available == false)
        && (!('lastDonation' in d) || isoString(d.lastDonation))
        && (!('updatedAt' in d) || isoString(d.updatedAt));
    }

    // ---------- each person's private profile: owner only ----------
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'bloodGroup', 'districtId', 'divisionId', 'area',
                                                 'donor', 'available', 'consent', 'updatedAt'])
        && shortString(request.resource.data.name, 80)
        && isBloodGroup(request.resource.data.bloodGroup)
        && shortString(request.resource.data.get('area', ''), 80);
      allow read: if isAdmin();
    }

    // ---------- admin accounts and activity log ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid; // lets the website check "am I an admin?"
      allow write: if false;                                // console only
    }
    match /audit/{id} {
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['action', 'collection', 'docId', 'summary', 'at', 'by']);
      allow read: if isAdmin();
      allow update, delete: if false; // the log cannot be changed or erased
    }
  }
}
