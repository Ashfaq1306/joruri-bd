{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "admin",
    "predeploy": [
      "node tools/admin-data/copy.mjs"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/app",
        "destination": "/download/",
        "type": 302
      }
    ]
  }
}
